# ==========================================
# Domain Setup
# ==========================================
type vendor_hisi_init, domain;
type vendor_hisi_init_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hisi_init) 

# ==========================================
# IPC and Sockets
# ==========================================
allow vendor_hisi_init init:unix_stream_socket connectto;
allow vendor_hisi_init property_socket:sock_file write; 

# ==========================================
# Device Nodes and Kernel Files
# ==========================================
allow vendor_hisi_init nve_block_device:blk_file { getattr open read };
allow vendor_hisi_init proc:file { getattr open read };
allow vendor_hisi_init proc_cmdline:file { getattr open read };
allow vendor_hisi_init sysfs:file { getattr open read };

# ==========================================
# Vendor Data Directories
# ==========================================
allow vendor_hisi_init vendor_bt_data_file:dir { add_name search write };
allow vendor_hisi_init vendor_bt_data_file:file { create getattr open write };

allow vendor_hisi_init vendor_hisi_data_file:dir r_dir_perms;
allow vendor_hisi_init vendor_hisi_data_file:file r_file_perms;

# Allow the hisi init process to fully manage the log directory
allow vendor_hisi_init vendor_kernel_log_file:dir { rw_dir_perms setattr };
allow vendor_hisi_init vendor_kernel_log_file:file { create_file_perms setattr };
allow vendor_hisi_init wifi_vendor_data_file:dir { add_name search write };
allow vendor_hisi_init wifi_vendor_data_file:file { create getattr open write };

# Allow hisi_init to read the boot block device
allow vendor_hisi_init boot_block_device:blk_file { read open getattr };
allow vendor_hisi_init block_device:dir search;

# Allow hisi_init to setup bluetooth mac files in /data/vendor/bluedroid
allow vendor_hisi_init vendor_data_file:dir { write add_name };
allow vendor_hisi_init vendor_data_file:file { create write open getattr };

# Allow hisi_init to open and write pmsg device
allow vendor_hisi_init pmsg_device:file { open write };


# ==========================================
# Properties
# ==========================================
# Hisi init needs to override standard permissions to configure the connectivity chip type
set_prop(vendor_hisi_init, vendor_wifi_prop)
set_prop(vendor_hisi_init, vendor_oem_prop)
set_prop(vendor_hisi_init, vendor_rild_prop)
set_prop(vendor_hisi_init, vendor_radio_prop)
set_prop(vendor_hisi_init, vendor_hisi_phone_config_prop)
