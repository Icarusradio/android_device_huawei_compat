cc_library_shared {
    name: "libhuawei_looper_compat",
    // Same-length as libutils.so for the CameraDaemon DT_NEEDED replacement.
    stem: "libhloop",
    srcs: ["LooperThreadState.cpp"],
    shared_libs: [
        "liblog",
        "libutils",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    header_libs: ["libutils_headers"],
    version_script: "looper_compat.map.txt",
    ldflags: [
        // GLOBAL lets later camera DSOs resolve the TLS entry points here;
        // NODELETE keeps the pthread-key destructor code mapped for thread exit.
        "-Wl,-z,global",
        "-Wl,-z,nodelete",
    ],
    vendor: true,
    host_supported: true,
    compile_multilib: "both",
    target: {
        host: {
            enabled: false,
        },
        linux_bionic: {
            enabled: true,
        },
    },
}

cc_library_shared {
    name: "looper_tls_test_consumer_a",
    srcs: ["tests/LooperConsumerA.cpp"],
    shared_libs: ["libutils"],
    header_libs: ["libutils_headers"],
    host_supported: true,
    target: {
        host: {
            enabled: false,
        },
        android: {
            enabled: false,
        },
        linux_bionic: {
            enabled: true,
        },
    },
}

