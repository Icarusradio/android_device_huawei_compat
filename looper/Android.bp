cc_test {
    name: "looper_tls_test_control",
    srcs: ["tests/LooperTLSHostTest.cpp"],
    shared_libs: ["libdl", "libutils"],
    header_libs: ["libutils_headers"],
    data_libs: ["looper_tls_dlopen_fixture"],
    test_suites: ["general-tests"],
    gtest: false,
    host_supported: true,
    target: {
        host: {
            enabled: false,
        },
        android: {
            enabled: false,
        },
        linux_bionic: {
            enabled: true,
        },
    },
}

cc_test {
    name: "looper_tls_test_compat",
    srcs: ["tests/LooperTLSHostTest.cpp"],
    shared_libs: [
        "libdl",
        "libutils",
        "libhuawei_looper_compat",
    ],
    header_libs: ["libutils_headers"],
    data_libs: ["looper_tls_dlopen_fixture"],
    cflags: ["-DLOOPER_TLS_TEST_COMPAT=1"],
    test_suites: ["general-tests"],
    gtest: false,
    host_supported: true,
    target: {
        host: {
            enabled: false,
